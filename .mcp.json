{
  "mcpServers": {
    "openclawcash": {
      "command": "npx",
      "args": [
        "-y",
        "@openclawcash/mcp-server@0.1.24"
      ],
      "env": {
        "OPENCLAWCASH_AGENT_KEY": "${user_config.agent_key}",
        "OPENCLAWCASH_BASE_URL": "${OPENCLAWCASH_BASE_URL:-https://openclawcash.com}"
      }
    }
  }
}
